{
  "name": "codewatch-desktop",
  "version": "0.3.0",
  "description": "CodeWatch local coding companion",
  "author": "CodeWatch contributors",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir --x64 --publish never",
    "portable": "electron-builder --win portable --x64 --publish never",
    "installer": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.codewatch.desktop",
    "productName": "CodeWatch",
    "asar": true,
    "directories": { "output": "../dist/windows" },
    "files": ["main.cjs", "preload.cjs", "smoke.cjs", "package.json"],
    "extraResources": [{ "from": "../build/sidecar/codewatch-helper.exe", "to": "codewatch-helper.exe" }],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "signAndEditExecutable": false,
      "artifactName": "CodeWatch-${version}-${arch}.${ext}"
    },
    "portable": { "unpackDirName": false, "artifactName": "CodeWatch-${version}-${arch}-portable.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true,
      "artifactName": "CodeWatch-${version}-${arch}-setup.${ext}" }
  }
}
